{
  "name": "milbareu/hellopack-composer-mirror",
  "require": {
    "vlucas/phpdotenv": "^5.6",
    "symfony/http-client": "^7.2",
    "nyholm/psr7": "^1.8",
    "symfony/filesystem": "^7.2",
    "ext-iconv": "*",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "MilBar\\HelloPackGitHubSync\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
